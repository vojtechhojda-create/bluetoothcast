{
  "manifest_version": 3,
  "name": "proxylink",
  "version": "1.0.0",
  "description": "send pages, links, images and text to your phone through the proxylink pc app",
  "browser_specific_settings": {
    "gecko": {
      "id": "proxylink@local.proxylink",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "notifications"
  ],
  "background": {
    "scripts": [
      "rpc.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "send to phone",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "open proxylink popup"
    },
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "send current page to phone"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
