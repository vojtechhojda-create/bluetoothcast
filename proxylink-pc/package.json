{
  "name": "proxylink-pc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:loopback": "dotnet publish loopback -c Release -r win-x64 --self-contained false -p:PublishSingleFile=true -o bin",
    "ext:run": "web-ext run --source-dir extension-zen",
    "ext:lint": "web-ext lint --source-dir extension-zen",
    "ext:sign": "web-ext sign --source-dir extension-zen --channel unlisted",
    "autostart": "node dist/autostart-cli.js"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0",
    "systray2": "^2.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "web-ext": "^8.3.0"
  }
}
